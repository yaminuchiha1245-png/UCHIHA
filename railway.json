{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway",
    "watchPatterns": [
      "builder/**",
      "Dockerfile.railway",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
