# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/uchiha-radius.sqlite
DATABASE_URL=postgresql://uchiha_radius:replace-me@127.0.0.1:5432/uchiha_radius
# حسابان منفصلان في الإنتاج: المالك/العامل لا يُستخدم لمسارات المزود
PLATFORM_DATABASE_URL=postgresql://uchiha_platform:replace-me@127.0.0.1:5432/uchiha_radius
# حساب مالك المخطط للمهاجرات فقط، ولا يُعطى لخدمة API
MIGRATION_DATABASE_URL=postgresql://uchiha_migrator:replace-me@127.0.0.1:5432/uchiha_radius
# حساب قراءة شامل مخصص للنسخ الاحتياطي؛ لا تستخدم حساب API
BACKUP_DATABASE_URL=postgresql://uchiha_backup:replace-me@127.0.0.1:5432/uchiha_radius
BACKUP_DIRECTORY=/var/backups/uchiha-radius
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=info

# Authentication
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
BOOTSTRAP_OWNER_EMAIL=owner@example.com
SESSION_TTL_HOURS=12
ALLOW_DEV_AUTH=true

# Secrets: generate both with `openssl rand -hex 32`
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
# Development fallback only. Production agents use a tenant-only key issued in the owner app.
CONNECTOR_SIGNING_SECRET=
BILLING_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# اختياري: خدمة إنشاء checkout محايدة عن مزود الدفع؛ اترك القيمتين فارغتين للمراجعة اليدوية
BILLING_CHECKOUT_ENDPOINT=
BILLING_CHECKOUT_TOKEN=
# مطلوب عند تفعيل checkout: أسماء المضيفين المسموح فتح روابط الدفع منها فقط
BILLING_CHECKOUT_ALLOWED_HOSTS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
OUTBOX_WORKER_ENABLED=true

# Production behavior
TRUST_PROXY=false
# في الإنتاج: نطاق الويب + أصل Capacitor Android، كلاهما HTTPS
CORS_ORIGINS=http://127.0.0.1:8787,https://localhost
METRICS_TOKEN=replace-with-at-least-24-random-characters
# الاحتفاظ التشغيلي؛ سجل التدقيق لا يُحذف آليًا
MAINTENANCE_AUTH_SESSION_DAYS=7
MAINTENANCE_WEBHOOK_DAYS=180
MAINTENANCE_SENT_OUTBOX_DAYS=30
MAINTENANCE_RADIUS_EVENT_DAYS=180

# FreeRADIUS-side agent (set on the RADIUS host, not the public API host)
RADIUS_AGENT_HOST=127.0.0.1
RADIUS_AGENT_PORT=8790
RADIUS_AGENT_DB=./data/radius-agent-spool.sqlite
RADIUS_AGENT_LOCAL_SECRET=replace-with-a-different-32-character-secret
# مفتاح مستقل لتشفير دليل الحسابات غير المتصل: `openssl rand -hex 32`
RADIUS_AGENT_CACHE_KEY=replace-with-64-hex-characters
RADIUS_AGENT_SIGNING_SECRET=replace-with-the-tenant-key-issued-once-by-owner
RADIUS_AGENT_ID=elite-core-01
RADIUS_AGENT_NAME=Elite Core RADIUS
RADIUS_AGENT_SITE_ID=
RADIUS_AGENT_ROLE=primary
RADIUS_AGENT_ENDPOINT=radius-core.internal:1812
RADIUS_COMMAND_ADAPTER=routeros
RADIUS_ROUTERS_FILE=/etc/uchiha-radius/routers.json
RADIUS_COMMAND_POLL_MS=2000
RADIUS_DIRECTORY_SYNC_MS=60000
RADIUS_HEARTBEAT_MS=15000
UCHIHA_API_URL=https://radius.uchiha-builder.com
UCHIHA_TENANT_SLUG=replace-with-tenant-slug
