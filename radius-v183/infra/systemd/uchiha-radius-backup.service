[Unit]
Description=UCHIHA RADIUS verified PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=uchiha-radius
Group=uchiha-radius
WorkingDirectory=/opt/uchiha-radius
EnvironmentFile=/etc/uchiha-radius/backup.env
ExecStart=/opt/uchiha-radius/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
LockPersonality=true
# The connection wrapper uses Node/V8, which requires executable JIT memory.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/backups/uchiha-radius
UMask=0077
