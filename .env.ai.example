# UCHIHA AI sellable Telegram bot product
# Keep real secrets in Railway Variables only. Never commit them.

# Telegram bot sold to the customer / product instance
AI_BOT_TOKEN=
# Telegram numeric ID of the bot owner who can open /admin
AI_ADMIN_ID=

# Central UCHIHA OpenAI API account
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# The admin "recharge" button opens this official billing page.
OPENAI_BILLING_URL=https://platform.openai.com/settings/organization/billing/overview

# Optional database path for this bot instance
AI_DB_PATH=uchiha_ai.db

# Default OpenAI models behind the commercial names.
# The admin can later change the mapping without changing UCHIHA AI V1/V2 names.
AI_V1_OPENAI_MODEL=gpt-5.6-luna
AI_V2_OPENAI_MODEL=gpt-5.6-sol

# Optional page or Telegram link used by users who tap Subscribe PRO.
AI_PRO_SUBSCRIBE_URL=
