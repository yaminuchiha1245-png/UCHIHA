[Unit]
Description=UCHIHA RADIUS-A Connector Backend v37
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uchiha-radius
Group=uchiha-radius
WorkingDirectory=/opt/uchiha-radius/current
EnvironmentFile=/etc/uchiha-radius/connector.env

ExecStartPre=/usr/bin/python3 -S -B /opt/uchiha-radius/current/RADIUS-A-Connector-Backend-v37.py --check-host
ExecStartPre=/usr/bin/python3 -S -B /opt/uchiha-radius/current/RADIUS-A-Connector-Backend-v37.py --check-config
ExecStart=/usr/bin/python3 -S -B /opt/uchiha-radius/current/RADIUS-A-Connector-Backend-v37.py

Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=45s
UMask=0077

StateDirectory=uchiha-radius
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/uchiha-radius
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
