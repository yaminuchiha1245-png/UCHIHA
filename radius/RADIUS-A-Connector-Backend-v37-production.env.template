# UCHIHA RADIUS-A v101 / Backend v37
# Fill CHANGE_ME only on the VPS. Never commit real secrets.

UCHIHA_CONNECTOR_HOST=127.0.0.1
UCHIHA_CONNECTOR_PORT=8790
UCHIHA_CONNECTOR_DB=/var/lib/uchiha-radius/connector.sqlite3
UCHIHA_CONNECTOR_ADAPTER=production-live
UCHIHA_CONNECTOR_ENABLE_LIVE=1
UCHIHA_CONNECTOR_LIVE_ACK=I_UNDERSTAND_LIVE_NETWORK_COMMANDS
UCHIHA_CONNECTOR_LIVE_DRIVER=mikrotik-gateway
UCHIHA_PRODUCTION_SITE=CHANGE_ME

# Browser operators + signed server/gateway requests.
UCHIHA_CONNECTOR_AUTH_MODE=hybrid
UCHIHA_BOOTSTRAP_OWNER_USERNAME=owner
UCHIHA_BOOTSTRAP_OWNER_PASSWORD_FILE=/etc/uchiha-radius/bootstrap-owner-password
UCHIHA_OPERATOR_PASSWORD_MIN_LENGTH=12
UCHIHA_OPERATOR_SCRYPT_N_LOG2=14
UCHIHA_OPERATOR_LOGIN_FAILURE_LIMIT=5
UCHIHA_OPERATOR_LOGIN_FAILURE_WINDOW_SECONDS=300
UCHIHA_LAUNCH_REQUIRE_OPERATOR_SESSION=1

# Create /etc/uchiha-radius/bootstrap-owner-password manually with chmod 600.
# Put the initial owner password in that file, not in this ENV file.
# After the first successful bootstrap and login, the file can be removed once the owner is persisted.

# Single active control-plane process for SQLite.
UCHIHA_INSTANCE_LOCK_REQUIRED=1
UCHIHA_INSTANCE_LOCK_PATH=/var/lib/uchiha-radius/connector.sqlite3.instance.lock
UCHIHA_LAUNCH_REQUIRE_INSTANCE_LOCK=1

# Host/filesystem preflight.
UCHIHA_HOST_PREFLIGHT_REQUIRED=1
UCHIHA_HOST_MIN_FREE_BYTES=536870912
UCHIHA_LAUNCH_REQUIRE_HOST_PREFLIGHT=1

# Trusted TLS reverse proxy.
UCHIHA_PUBLIC_HTTPS_REQUIRED=1
UCHIHA_TRUST_PROXY_HEADERS=1
UCHIHA_TRUSTED_PROXY_CIDRS=127.0.0.1/32
UCHIHA_REJECT_UNTRUSTED_PROXY_HEADERS=1
UCHIHA_COOKIE_SECURE=1
UCHIHA_HSTS_ENABLED=1
UCHIHA_HSTS_MAX_AGE=31536000
UCHIHA_HSTS_INCLUDE_SUBDOMAINS=0
UCHIHA_HSTS_PRELOAD=0

# Signed Gateway HMAC.
UCHIHA_CONNECTOR_GATEWAY_HMAC_SECRET=CHANGE_ME_SECRET
UCHIHA_CONNECTOR_GATEWAY_HMAC_KEY_ID=primary-2026
UCHIHA_CONNECTOR_GATEWAY_HMAC_PREVIOUS_SECRET=
UCHIHA_CONNECTOR_GATEWAY_HMAC_PREVIOUS_KEY_ID=
UCHIHA_CONNECTOR_GATEWAY_HMAC_MAX_SKEW=120
UCHIHA_CONNECTOR_GATEWAY_NONCE_RETENTION=600
UCHIHA_GATEWAY_REQUIRE_HTTPS=1
UCHIHA_GATEWAY_LEGACY_KEY_AUTH=0
UCHIHA_LAUNCH_REQUIRE_GATEWAY_HMAC=1

# Edge protection.
UCHIHA_EDGE_MAX_CONCURRENT_REQUESTS=128
UCHIHA_EDGE_SOCKET_TIMEOUT_SECONDS=15
UCHIHA_EDGE_GATEWAY_AUTH_FAILURE_LIMIT=30
UCHIHA_EDGE_GATEWAY_AUTH_FAILURE_WINDOW_SECONDS=60
UCHIHA_LAUNCH_REQUIRE_EDGE_PROTECTION=1

# Core RADIUS / MikroTik.
UCHIHA_RADIUS_HOST=CHANGE_ME
UCHIHA_RADIUS_AUTH_PORT=1812
UCHIHA_RADIUS_ACCT_PORT=1813
UCHIHA_RADIUS_SECRET=CHANGE_ME_SECRET
UCHIHA_RADIUS_PROBE_MODE=tcp
UCHIHA_REQUIRE_CONNECTIVITY_PREFLIGHT=1
UCHIHA_MIKROTIK_BASE_URL=https://CHANGE_ME
UCHIHA_MIKROTIK_TOKEN=CHANGE_ME_SECRET
UCHIHA_CONNECTOR_ALLOW_INSECURE_MIKROTIK=0

# Verified local backup.
UCHIHA_BACKUP_DIR=/var/lib/uchiha-radius/backups
UCHIHA_BACKUP_RETENTION=12

# Required off-host backup.
UCHIHA_BACKUP_OFFHOST_ENABLE=1
UCHIHA_BACKUP_OFFHOST_ACK=I_UNDERSTAND_OFFHOST_BACKUP_REPLICATION
UCHIHA_BACKUP_OFFHOST_GATEWAY_URL=https://CHANGE_ME
UCHIHA_BACKUP_OFFHOST_GATEWAY_TOKEN=CHANGE_ME_SECRET
UCHIHA_BACKUP_OFFHOST_GATEWAY_PATH=/api/backups/objects
UCHIHA_BACKUP_OFFHOST_TIMEOUT=15
UCHIHA_BACKUP_OFFHOST_ALLOW_INSECURE=0
UCHIHA_BACKUP_OFFHOST_AUTO_REPLICATE=1

# Exact release integrity.
UCHIHA_RELEASE_INTEGRITY_REQUIRED=1
UCHIHA_RELEASE_INTEGRITY_MANIFEST=/opt/uchiha-radius/current/UCHIHA-RADIUS-v101-Backend-v37-INTEGRITY.json
UCHIHA_RELEASE_INTEGRITY_MANIFEST_SHA256=4b35c6efaf273b4659e8df8196c4d45a4d6ad41037c332c087f2f3f7db643e8d
UCHIHA_LAUNCH_REQUIRE_RELEASE_INTEGRITY=1

# Strict launch policy.
UCHIHA_LAUNCH_REQUIRE_HTTPS=1
UCHIHA_LAUNCH_REQUIRE_VERIFIED_BACKUP=1
UCHIHA_LAUNCH_REQUIRE_RECOVERY_DRILL=1
UCHIHA_LAUNCH_REQUIRE_OFFHOST_BACKUP=1
UCHIHA_LAUNCH_REQUIRE_POST_DEPLOY_VERIFICATION=1

# Optional day-one gates.
UCHIHA_LAUNCH_REQUIRE_REMOTE_LOG_SHIPPING=0
UCHIHA_LAUNCH_REQUIRE_TELEGRAM=0
UCHIHA_LAUNCH_REQUIRE_VOUCHERS=0
UCHIHA_LAUNCH_REQUIRE_DIRECT_RADIUS=0

# Queue / shutdown.
UCHIHA_QUEUE_WORKER_ENABLED=1
UCHIHA_QUEUE_POLL_SECONDS=0.5
UCHIHA_QUEUE_MAX_ATTEMPTS=5
UCHIHA_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
UCHIHA_GRACEFUL_SHUTDOWN_POLL_SECONDS=0.1
UCHIHA_DRAIN_MAX_WAIT_SECONDS=30
UCHIHA_DRAIN_POLL_SECONDS=0.1
UCHIHA_MAINTENANCE_MODE=0

# Monitoring.
UCHIHA_ALERT_MONITOR_ENABLED=1
UCHIHA_ALERT_POLL_SECONDS=15
UCHIHA_METRICS_PUBLIC=0
UCHIHA_LOG_FORMAT=json
UCHIHA_LOG_LEVEL=INFO
UCHIHA_LOG_HTTP=1

# Optional integrations.
UCHIHA_TELEGRAM_ALERTS_ENABLED=0
UCHIHA_TELEGRAM_BOT_TOKEN=
UCHIHA_TELEGRAM_CHAT_ID=
UCHIHA_LOG_REMOTE_ENABLE=0
UCHIHA_LOG_REMOTE_URL=
UCHIHA_LOG_REMOTE_TOKEN=
UCHIHA_VOUCHER_PROVISION_ENABLE=0
UCHIHA_VOUCHER_GATEWAY_URL=
UCHIHA_VOUCHER_GATEWAY_TOKEN=
UCHIHA_RADIUS_COA_ENABLE=0
UCHIHA_RADIUS_COA_SECRET=
UCHIHA_RADIUS_COA_ALLOWED_HOSTS=

UCHIHA_SMOKE_BASE_URL=https://CHANGE_ME
UCHIHA_SMOKE_ACTOR=launch-smoke
UCHIHA_SMOKE_ROLE=owner
