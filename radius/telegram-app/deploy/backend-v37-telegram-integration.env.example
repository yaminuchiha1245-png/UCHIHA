# Add these values to the existing Backend v37 production environment.
# v37 remains the authoritative RADIUS command queue; the dispatcher routes
# live MikroTik commands to the correct provider's outbound site agent.

UCHIHA_CONNECTOR_PORT=8792
UCHIHA_CONNECTOR_AUTH_MODE=hybrid
UCHIHA_CONNECTOR_GATEWAY_HMAC_KEY_ID=telegram-provider
UCHIHA_CONNECTOR_GATEWAY_HMAC_SECRET=
UCHIHA_GATEWAY_LEGACY_KEY_AUTH=0

# The Telegram provider sidecar reaches v37 over loopback while v37 enforces
# the public HTTPS boundary through trusted-proxy headers.
UCHIHA_PUBLIC_HTTPS_REQUIRED=1
UCHIHA_TRUST_PROXY_HEADERS=1
UCHIHA_TRUSTED_PROXY_CIDRS=127.0.0.1/32
UCHIHA_COOKIE_SECURE=1
UCHIHA_HSTS_ENABLED=1

# Production live driver points only at the local multi-provider dispatcher.
UCHIHA_CONNECTOR_ADAPTER=production-live
UCHIHA_CONNECTOR_ENABLE_LIVE=1
UCHIHA_CONNECTOR_LIVE_ACK=I_UNDERSTAND_LIVE_NETWORK_COMMANDS
UCHIHA_CONNECTOR_LIVE_DRIVER=mikrotik-gateway
UCHIHA_MIKROTIK_BASE_URL=http://127.0.0.1:8791
UCHIHA_MIKROTIK_TOKEN=
UCHIHA_CONNECTOR_ALLOW_INSECURE_MIKROTIK=1
UCHIHA_PRODUCTION_SITE=UCHIHA-RADIUS
