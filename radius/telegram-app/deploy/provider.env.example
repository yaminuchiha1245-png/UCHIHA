# Central UCHIHA RADIUS Telegram provider runtime
# Copy to /etc/uchiha-radius/provider.env with mode 0600.

TELEGRAM_BOT_TOKEN=
UCHIHA_RADIUS_OWNER_TELEGRAM_ID=
UCHIHA_RADIUS_DEFAULT_PROVIDER_NAME=UCHIHA Provider
UCHIHA_RADIUS_DEFAULT_PROVIDER_CODE=UCHIHA

UCHIHA_RADIUS_PROVIDER_DB=/var/lib/uchiha-radius/provider.sqlite3
UCHIHA_RADIUS_PROVIDER_BIND=127.0.0.1
UCHIHA_RADIUS_PROVIDER_PORT=8788
UCHIHA_RADIUS_PUBLIC_ORIGIN=https://radius.uchiha-builder.com
UCHIHA_RADIUS_TELEGRAM_WEBAPP_URL=https://radius.uchiha-builder.com/telegram/
UCHIHA_RADIUS_TELEGRAM_AUTH_MAX_AGE=900
UCHIHA_RADIUS_SESSION_TTL=28800

# Use a separate random secret for provider-session CSRF derivation.
UCHIHA_RADIUS_PROVIDER_CSRF_SECRET=

# Backend v37 runs locally on its documented port 8790.
# The same HMAC key id/secret must be configured in Backend v37.
UCHIHA_RADIUS_V37_BASE_URL=http://127.0.0.1:8790
UCHIHA_RADIUS_V37_HMAC_KEY_ID=telegram-provider
UCHIHA_RADIUS_V37_HMAC_SECRET_FILE=/etc/uchiha-radius/v37-gateway-hmac.secret
# Alternative to the secret file (do not set both):
# UCHIHA_RADIUS_V37_HMAC_SECRET=
