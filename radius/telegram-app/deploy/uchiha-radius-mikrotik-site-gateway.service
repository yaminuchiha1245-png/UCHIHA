[Unit]
Description=UCHIHA RADIUS MikroTik site gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uchiha-radius
Group=uchiha-radius
WorkingDirectory=/opt/uchiha-radius/site-gateway
EnvironmentFile=/etc/uchiha-radius/site-gateway.env
ExecStart=/usr/bin/python3 /opt/uchiha-radius/site-gateway/mikrotik_site_gateway.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
