# Install on a trusted host that can reach the provider's MikroTik.
# Keep this file readable only by the service account.
UCHIHA_SITE_GATEWAY_BIND=127.0.0.1
UCHIHA_SITE_GATEWAY_PORT=8789
UCHIHA_SITE_GATEWAY_TOKEN=
UCHIHA_ROUTEROS_BASE_URL=https://192.168.88.1
UCHIHA_ROUTEROS_USERNAME=
UCHIHA_ROUTEROS_PASSWORD=
UCHIHA_ROUTEROS_ALLOW_INSECURE=0
