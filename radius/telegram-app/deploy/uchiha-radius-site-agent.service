[Unit]
Description=UCHIHA RADIUS outbound provider site agent
After=network-online.target uchiha-radius-mikrotik-site-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=uchiha-radius
Group=uchiha-radius
WorkingDirectory=/opt/uchiha-radius/site-gateway
EnvironmentFile=/etc/uchiha-radius/site-agent.env
ExecStart=/usr/bin/python3 /opt/uchiha-radius/site-gateway/site_agent.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
