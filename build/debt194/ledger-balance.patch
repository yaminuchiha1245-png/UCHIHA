+/* UCHIHA Debt Store v1.5.38 — preserve signed balances in original currency. */
+(function(root){
+'use strict';
+const currencies=['USD','TRY'];
+const blank=()=>({USD:0,TRY:0});
+function compareEntries(a,b){
+  const time=e=>new Date(e.createdAt||e.date||0).getTime()||0;
+  const difference=time(a)-time(b);
+  if(difference)return difference;
+  const paymentDifference=Number(a.type==='payment')-Number(b.type==='payment');
+  if(paymentDifference)return paymentDifference;
+  const identity=e=>String(e.syncKey||e.cloudId||e.remoteId||e.id||'');
+  return identity(a).localeCompare(identity(b));
+}
+function cents(value){
+  const n=Number(String(value??'').replace(/,/g,''));
+  return Number.isFinite(n)?Math.round((n+Number.EPSILON)*100):0;
+}
+function advance(balance,entry){
+  const cur=entry.originalCurrency;
+  if(!currencies.includes(cur))return balance;
+  const sign=['purchase','opening'].includes(entry.type)?1:entry.type==='payment'?-1:0;
+  balance[cur]=(cents(balance[cur])+sign*cents(entry.originalAmount))/100;
+  return balance;
+}
+function summarize(rows){
+  const signed=blank(),purchases=blank(),payments=blank(),excessPayments=[];
+  for(const entry of rows||[]){
+    const cur=entry.originalCurrency;
+    if(!currencies.includes(cur))continue;
+    const amount=cents(entry.originalAmount);
+    if(['purchase','opening'].includes(entry.type))purchases[cur]=(cents(purchases[cur])+amount)/100;
+    else if(entry.type==='payment'){
+      payments[cur]=(cents(payments[cur])+amount)/100;
+      const excess=amount-Math.max(0,cents(signed[cur]));
+      if(excess>0)excessPayments.push({entry,excess:excess/100});
+    }
+    advance(signed,entry);
+  }
+  const due=blank(),credit=blank();
+  for(const cur of currencies){due[cur]=Math.max(0,signed[cur]);credit[cur]=Math.max(0,-signed[cur]);}
+  return {signed,due,credit,purchases,payments,excessPayments};
+}
+root.DebtLedgerBalanceV194={version:'1.5.38',advance,summarize,compareEntries};
+})(typeof window!=='undefined'?window:globalThis);
