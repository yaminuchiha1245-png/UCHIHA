[Unit]
Description=UCHIHA Telegram health alert watcher
After=network-online.target docker.service uchiha-telegram-control-bot.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/uchiha/telegram-control
EnvironmentFile=/etc/uchiha-telegram-control.env
ExecStart=/usr/bin/python3 /opt/uchiha/telegram-control/watcher.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/uchiha-infra /var/lib/docker/volumes/uchiha-control_uchiha_data/_data
ReadWritePaths=/var/lib/uchiha-telegram-control
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX