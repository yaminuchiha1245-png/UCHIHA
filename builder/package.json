{
  "name": "uchiha-builder",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "UCHIHA Builder multi-tenant commerce platform vertical slice",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/start.mjs",
    "worker": "node src/worker-runner.mjs",
    "bootstrap": "node src/bootstrap.mjs",
    "demo:ensure": "node src/showcase-ensure.mjs",
    "admin:ensure": "node src/admin-ensure.mjs",
    "maintenance": "node src/maintenance.mjs",
    "dev:demo": "node src/demo.mjs",
    "smoke:staging": "node src/smoke.mjs",
    "smoke:production": "node src/smoke.mjs",
    "verify:production": "node src/production-readiness.mjs",
    "test": "npm run test:unit",
    "check": "node scripts/check-syntax.mjs",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "test:unit": "node --test --test-reporter=spec --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.2",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "pg-mem": "3.0.14"
  }
}
