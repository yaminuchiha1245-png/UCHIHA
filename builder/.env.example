NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Production requires PostgreSQL. DATABASE_MODE=memory is only for local demo/tests.
DATABASE_MODE=postgres
DATABASE_URL=postgresql://uchiha:change-me@localhost:5432/uchiha_builder
DATABASE_SSL=false

APP_BASE_URL=http://localhost:4100
STORE_BASE_DOMAIN=uchiha.store
COOKIE_SECURE=false

# Base64-encoded 32-byte key. Generate a new key per environment.
APP_ENCRYPTION_KEY=

# Demo-only switches. Keep disabled in production.
ALLOW_DEMO_BILLING=false
DEMO_SEED=false
TELEGRAM_MODE=live


# Per-process protection for sensitive endpoints. Use a shared gateway/Redis limiter when scaling to multiple API instances.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=12
PURCHASE_RATE_LIMIT_MAX=30
WORKER_LEASE_SECONDS=600

# The offer is data, not a code constant. These values only seed an empty environment.
UCHIHA_FULL_NAME=UCHIHA Full
UCHIHA_FULL_PRICE_MINOR=
UCHIHA_FULL_RENEWAL_PRICE_MINOR=
UCHIHA_FULL_CURRENCY=USD
UCHIHA_FULL_DURATION_UNIT=month
UCHIHA_FULL_DURATION_COUNT=
UCHIHA_FULL_TRIAL_DAYS=

# Optional first platform administrator.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Provider credentials stay encrypted in PostgreSQL. Do not commit them.
UCHIHA_API_1_TOKEN=
UCHIHA_API_1_MODE=test
