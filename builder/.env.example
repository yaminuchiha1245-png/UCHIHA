NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Preview-only memory mode. Safe for UI review; data resets on restart.
PREVIEW_MEMORY_MODE=false
REQUIRE_PERSISTENT_DATABASE=true

# Production requires PostgreSQL. Railway can provide DATABASE_URL, DATABASE_PRIVATE_URL,
# POSTGRES_URL, PGURL, or the standard PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE variables.
DATABASE_MODE=postgres
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# On Railway APP_BASE_URL is derived automatically from RAILWAY_PUBLIC_DOMAIN when omitted.
APP_BASE_URL=http://localhost:4100
STORE_BASE_DOMAIN=uchiha.store
COOKIE_SECURE=false
PLATFORM_WHATSAPP_NUMBER=+963942586044

# Base64-encoded 32-byte key. Generate a new key per environment.
APP_ENCRYPTION_KEY=

# Demo-only switches. Keep disabled in production. Preview memory mode forces safe fake/test behavior.
ALLOW_DEMO_BILLING=false
DEMO_SEED=false
TELEGRAM_MODE=live

# UCHIHA AI product defaults. OPENAI_API_KEY is optional and is NOT required to sell the product.
# BotFather Token is entered by the purchaser on the product page after payment.
# Each purchased bot owner links their own OpenAI API key from /admin in Telegram.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_BILLING_URL=https://platform.openai.com/settings/organization/billing/overview
OPENAI_FREE_MODEL=gpt-5.6-luna
OPENAI_PRO_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Emergency platform-wide daily cap across all sold AI bots. Bot owners configure
# their own Free/PRO limits from /admin within the database safety constraints.
AI_PLATFORM_DAILY_REQUEST_LIMIT=50000

# Per-process protection for sensitive endpoints. Use a shared gateway/Redis limiter when scaling to multiple API instances.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=12
PURCHASE_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_MAX=120
WORKER_LEASE_SECONDS=600

# The offer is data, not a code constant. These values only seed an empty environment.
UCHIHA_FULL_NAME=UCHIHA Full
UCHIHA_FULL_PRICE_MINOR=
UCHIHA_FULL_RENEWAL_PRICE_MINOR=
UCHIHA_FULL_CURRENCY=USD
UCHIHA_FULL_DURATION_UNIT=month
UCHIHA_FULL_DURATION_COUNT=
UCHIHA_FULL_TRIAL_DAYS=

# Optional first platform administrator.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Optional preview-only customer. Leave passwords in the environment, never in source control.
PREVIEW_CUSTOMER_EMAIL=
PREVIEW_CUSTOMER_PASSWORD=

# Provider credentials stay encrypted in PostgreSQL. Do not commit them.
UCHIHA_API_1_TOKEN=
UCHIHA_API_1_MODE=test
UCHIHA_API_1_ADAPTER=mock
UCHIHA_API_1_BASE_URL=