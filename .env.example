# UCHIHA Telegram bots
BOT_TOKEN=
PLATFORM_BOT_TOKEN=
ADMIN_ID=
PLATFORM_OWNER_ID=

# Databases / runtime
DB_PATH=store.db
DATABASE_URL=sqlite+aiosqlite:///./uchiha_platform.db
PORT=8080

# Public storefront
STOREFRONT_NAME=Uchiha Store
STOREFRONT_TELEGRAM_URL=https://t.me/UchihaStoreBot
STOREFRONT_SUPPORT_URL=https://t.me/UchihaStoreBot
STOREFRONT_CURRENCY_CODE=USD
# أضف أسعار العرض التي تعتمدها؛ مثال: {"USD":1,"EUR":0.92,"TRY":32.5}
STOREFRONT_EXCHANGE_RATES={"USD":1}
STOREFRONT_WEB_ENABLED=1
STOREFRONT_API_ENABLED=1
STOREFRONT_PUBLIC_CATALOG_ENABLED=1
# أنشئ قيمة عشوائية طويلة ولا تنشرها في GitHub.
STOREFRONT_SESSION_SECRET=
# دخول لوحة المالك: https://YOUR-DOMAIN/admin
STOREFRONT_ADMIN_USERNAME=admin
STOREFRONT_ADMIN_PASSWORD=
# بديل أكثر أمانًا لكلمة المرور النصية؛ عند ضبطه اترك المتغير السابق فارغًا.
STOREFRONT_ADMIN_PASSWORD_HASH=
# Railway يستخدم HTTPS؛ اتركها 1 في الإنتاج و0 عند الاختبار المحلي عبر HTTP.
STOREFRONT_COOKIE_SECURE=1

# JS4Card supplier
API_TOKEN=

# Binance Wallet read-only integration
# The legacy name BINANCE_PAYMENT_ENABLED=1 is also supported.
BINANCE_AUTO_PAY_ENABLED=0
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_COIN=USDT
BINANCE_NETWORK=TRX
BINANCE_DEPOSIT_ADDRESS=
BINANCE_MIN_AMOUNT=5
BINANCE_MAX_AMOUNT=1000
BINANCE_UNIQUE_STEP=0.001
BINANCE_UNIQUE_SLOTS=99
BINANCE_PAYMENT_WINDOW_MINUTES=120
BINANCE_POLL_SECONDS=60
BINANCE_RECV_WINDOW=5000
BINANCE_START_DELAY_SECONDS=10
BINANCE_ADMIN_HISTORY_LIMIT=12

# Sham Cash future API connection
# Keep the token in Railway Variables only. Leave the base URL empty until the
# official provider gives you its server-side API documentation.
SHAMCASH_API_ENABLED=0
SHAMCASH_API_TOKEN=
SHAMCASH_API_BASE_URL=
SHAMCASH_API_AUTH_HEADER=Authorization
SHAMCASH_API_AUTH_SCHEME=Bearer
SHAMCASH_API_ACCOUNTS_PATH=/accounts
SHAMCASH_API_BALANCES_PATH=/balances
SHAMCASH_API_TRANSACTIONS_PATH=/transactions
SHAMCASH_ACCOUNT_ID=
