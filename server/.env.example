PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=https://your-domain.com
BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN_HERE
SUPPORT_USERNAME=GameZoneSupport
INTERNAL_BOT_SECRET=CHANGE_THIS_SECRET
INTERNAL_BOT_ADMIN_SECRET=CHANGE_DEDICATED_BOT_ADMIN_SECRET

# Admin API / Admin Center
# ADMIN_KEY is legacy development-only and must remain disabled in production.
ADMIN_KEY=dev-admin-key
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=USE_A_LONG_RANDOM_SECRET
USER_SESSION_SECRET=USE_A_DIFFERENT_LONG_RANDOM_SECRET
ALLOW_LEGACY_ADMIN_KEY=false
ADMIN_TELEGRAM_IDS=123456789,987654321

# Digital inventory encryption: recommended 32-byte random key encoded as Base64.
# Example generation: openssl rand -base64 32
INVENTORY_ENCRYPTION_KEY=
# 32-byte base64 key, different from inventory key
BACKUP_ENCRYPTION_KEY=GENERATE_A_DISTINCT_32_BYTE_BASE64_KEY

# Provider webhook protection
PROVIDER_WEBHOOK_SECRET=CHANGE_PROVIDER_WEBHOOK_SECRET

# Example supplier API token. Provider configs reference the ENV variable name, not the secret itself.
SUPPLIER_TOKEN=

# Runtime storage
# json = local development file
# postgres = PostgreSQL-backed runtime snapshot
STORAGE_DRIVER=json
DATABASE_URL=postgresql://gamezone:password@localhost:5432/gamezone
PG_SSL=false

# Automatic provider-order status synchronization.
# Minimum effective interval is 15000 ms.
ORDER_SYNC_INTERVAL_MS=60000

BOT_USERNAME=YourGameZoneBot

PAYMENT_WEBHOOK_SECRET=CHANGE_PAYMENT_WEBHOOK_SECRET

PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_PERSIST_RETRIES=3

PUBLIC_BASE_URL=https://gamezone.example.com

# Restart the server if a critical PostgreSQL write cannot be persisted
STORAGE_FAIL_FAST=true

# Server process only: prevents accidental multiple active snapshot writers
PG_SINGLE_INSTANCE_LOCK=true

# Max wait for per-user/order/top-up serialization before returning 503
OPERATION_LOCK_TIMEOUT_MS=30000

# Backup retention
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_FILES=30

# Reject replayed Telegram Mini App initData older than this (default 1 hour)
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Separate secret used to make Admin audit-chain hashes tamper-resistant
AUDIT_HMAC_KEY=CHANGE_TO_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Separate HMAC secret for active/history PostgreSQL snapshots
STATE_HMAC_KEY=CHANGE_TO_ANOTHER_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Pseudonymous immutable financial journal HMAC. Must be distinct.
FINANCIAL_JOURNAL_HMAC_KEY=CHANGE_TO_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Distinct key for pseudonymous PostgreSQL wallet authority account HMACs
WALLET_AUTHORITY_HMAC_KEY=CHANGE_TO_ANOTHER_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARS
# HMAC key for authoritative order/top-up records.
BUSINESS_AUTHORITY_HMAC_KEY=CHANGE_TO_A_DISTINCT_BUSINESS_AUTHORITY_SECRET_AT_LEAST_32_CHARS

# Bounded JSON parser size; bulk inventory may need up to the default 2 MB
JSON_BODY_LIMIT=2mb


# Admin readiness / backup worker health threshold
BACKUP_MAX_AGE_HOURS=48
# Keep false unless a deliberately controlled production supplier is on a private network
ALLOW_PRODUCTION_PRIVATE_PROVIDER=false
# Keep false: real production suppliers should use HTTPS
ALLOW_PRODUCTION_INSECURE_PROVIDER=false

# Pre-restore/pre-migration safety-copy retention
SAFETY_BACKUP_RETENTION_DAYS=90
SAFETY_BACKUP_MAX_FILES=60

# Backup worker retry/restart policy
BACKUP_RETRY_SECONDS=300
BACKUP_MAX_CONSECUTIVE_FAILURES=3

# Stop accepting ready traffic, drain HTTP, then force-close after this grace period
SHUTDOWN_GRACE_MS=10000

# PostgreSQL snapshot revision/history integrity
PG_STATE_HISTORY_MAX=200
PG_STATE_HISTORY_RETENTION_DAYS=90
# Full JSONB rollback snapshots are throttled to avoid database bloat.
PG_STATE_HISTORY_MIN_INTERVAL_SECONDS=300
STATE_VERIFY_INTERVAL_MS=300000

# Normalized financial mirror (required in production)
PG_FINANCIAL_MIRROR=true

# Immutable financial mutation journal / balance-change guard
PG_FINANCIAL_JOURNAL=true

# PostgreSQL wallet authority (required in production)
PG_WALLET_AUTHORITY=true
PG_BUSINESS_AUTHORITY=true

# Uploaded catalog images / private payment receipts
UPLOAD_DIR=/app/server/uploads
RECEIPT_DIR=/app/server/receipts
IMAGE_UPLOAD_MAX_BYTES=2097152
RECEIPT_MAX_BYTES=1048576
